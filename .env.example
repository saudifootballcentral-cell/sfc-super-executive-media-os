# ================================================================
# SFC Super Executive Media OS — Environment Variables
# Copy to .env and fill in real values. Never commit .env.
# ================================================================

# --- AI Provider ---
ANTHROPIC_API_KEY=sk-ant-...

# --- System ---
SFC_ENVIRONMENT=development          # development | staging | production
SFC_LOG_LEVEL=INFO
SFC_LOG_FORMAT=json                  # json | text

# --- LangGraph / Checkpointing ---
# Leave blank to use in-memory checkpointing (no persistence)
LANGGRAPH_CHECKPOINT_DB_URL=

# --- Memory Persistence (optional Redis for distributed deployments) ---
REDIS_URL=

# --- Platform API Keys (wired up in Package 2+) ---
TIKTOK_API_KEY=
INSTAGRAM_API_KEY=
YOUTUBE_API_KEY=
TWITTER_BEARER_TOKEN=
TELEGRAM_BOT_TOKEN=

# --- Cost Alert ---
SFC_COST_ALERT_USD=100.0
